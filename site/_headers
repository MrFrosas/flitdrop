# Cloudflare Pages headers: long-cache the fingerprint-free static assets,
# always revalidate HTML, and set a sane baseline of security headers.
# CSP (report only) allows exactly what js/analytics.js loads. PostHog goes through
# the same-origin /ph relay (functions/ph), so 'self' covers it; blob: and data: are for the
# session replay workers.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://static.cloudflareinsights.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://cloudflareinsights.com https://api.github.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com; worker-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self'; frame-ancestors 'none'

# Page Flitdrop Pro (/pro, /fr/pro, /de/pro) : Paddle.js v2, chargé seulement au clic
# sur « Débloquer » (le prix affiché vient de /api/license/config, même domaine).
# Hôtes relevés dans paddle.js lui-même (Paddle ne publie pas de liste CSP) : script
# sur cdn.paddle.com, feuilles de style et images sur cdn / sandbox-cdn, fenêtre de
# paiement (iframe) sur buy / sandbox-buy, appels api / sandbox-api ; checkout-service
# et sandbox-checkout-service sont appelés depuis l'iframe, *.paddle.com les couvre.
# La rétractation de /refund (POST /api/withdraw) est sur le même domaine : 'self'.
# La politique générale est retirée (« ! ») puis remplacée : sinon les deux se
# cumuleraient et la plus stricte signalerait Paddle. Ces blocs restent APRÈS /*.
/pro
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://static.cloudflareinsights.com https://cdn.paddle.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://cloudflareinsights.com https://api.github.com https://*.paddle.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://cdn.paddle.com https://sandbox-cdn.paddle.com; frame-src 'self' https://*.paddle.com; worker-src 'self' blob: data:; style-src 'self' 'unsafe-inline' https://cdn.paddle.com https://sandbox-cdn.paddle.com; font-src 'self'; base-uri 'self'; frame-ancestors 'none'

/:lang/pro
